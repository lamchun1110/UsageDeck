{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UsageDeck",
  "version": "0.7.0",
  "identifier": "com.lamchun1110.usagedeck",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UsageDeck",
        "width": 380,
        "height": 800,
        "minWidth": 320,
        "minHeight": 240,
        "maxWidth": 560,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1MzYwNDM5ODQzOTFDNzYKUldSMkhEbUVPUVEyRmRSZVNkM21UTlh5N0p4S29nY2NPWFoyT1VoeVhud2RpalhhdzlCbTBDMVcK",
      "endpoints": ["https://github.com/lamchun1110/UsageDeck/releases/latest/download/latest.json"]
    }
  }
}
